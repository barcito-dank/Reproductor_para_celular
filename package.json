{
  "name": "reproductor-de-musica",
  "version": "1.0.0",
  "description": "Reproductor de música personal con interfaz moderna y oscura",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cap:sync": "vite build && npx cap sync android",
    "cap:open": "npx cap open android",
    "android:run": "vite build && npx cap run android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "music-metadata": "^10.6.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.9.3",
    "vite": "^5.0.12",
    "vitest": "^2.1.9"
  }
}
